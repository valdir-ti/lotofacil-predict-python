DEBUG=False
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5.4-nano
LLM_MAX_DRAWS=500
LLM_GAME_COUNT=3
MAX_CONFIRMATION_GAMES=20
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-unique-random-value
ALLOWED_HOSTS=localhost,127.0.0.1,api.lotof.intratec.dev.br
CSRF_TRUSTED_ORIGINS=https://api.lotof.intratec.dev.br,https://lotof.intratec.dev.br
CORS_ALLOWED_ORIGINS=https://lotof.intratec.dev.br
SECURE_SSL_REDIRECT=True
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
# Required when LLM_PROVIDER=openai. Keep this value only in your local .env.
OPENAI_API_KEY=

# Google OAuth (OAuth 2.0 Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
